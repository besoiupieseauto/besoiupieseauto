APP_ENV=development
APP_URL=https://besoiupieseauto.ro

# Mod la cerere (recomandat): 1 = fără API în fundal/cron/site; doar cache local + apeluri explicite din admin.
# 0 = permite consum automat (cron, site fără cache, agenți). CLI one-shot: BESOIU_API_LIVE_OVERRIDE=1 php ...
API_AUTOMATION_DISABLED=1
# 1 = API plătit doar după «Armez API live» în admin (sesiune 5–240 min). Implicit activ când API_AUTOMATION_DISABLED=1.
API_STRICT_MANUAL=1

# Webhook plată online (obligatoriu în producție)
PAYMENT_WEBHOOK_KEY=

# Criptare credențiale conturi PieseAuto.ro (AES-256-GCM; generează 32+ caractere random)
PIESEAUTO_CREDENTIAL_KEY=

DB_HOST=127.0.0.1
DB_NAME=besoiupieseauto.ro
DB_USER=root
DB_PASS=

# Baza secundara pentru modulul "Caiet de comenzi" (Laravel legacy).
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_NAME=caietcom_comenzilv
LEGACY_DB_USER=root
LEGACY_DB_PASS=

# Supplier Search — credențiale API live (distincte de FTP/import din cartela furnizor)
MATEROM_TOKEN_TIMISOARA=
MATEROM_TOKEN_UTVIN=
MATEROM_API_BASE_URL=https://api.materom.ro/api
AUTONET_TAX_CODE=RO31298897
AUTONET_SECURITY_TOKEN=08VGHXNPAH
AUTONET_BRANCH=MAG1
AUTOTOTAL_USERNAME=
AUTOTOTAL_PASSWORD=
AUTOTOTAL_USER_TIMISOARA=
AUTOTOTAL_PASS_TIMISOARA=
AUTOTOTAL_AVAILABILITY_URL=https://atx.autototal.ro:15063

OPENAI_KEY=
IMAGE_AUDIT_ENGINE=manual
# cursor | openai | ollama (llava local) | manual
IMAGE_AUDIT_MODEL=gpt-4o-mini
IMAGE_AUDIT_OPENAI_FALLBACK=0
IMAGE_AUDIT_ON_IMPORT=1
IMPORT_OLLAMA_AUDIT_ON_PUBLISH=1
IMPORT_OLLAMA_QUALITY_CHECK=1
IMPORT_OLLAMA_QUALITY_ON_SCAN=0
IMPORT_QUALITY_MIN_SCORE=70
IMPORT_OLLAMA_QUALITY_LLM=0
CATALOG_RAG_ENABLED=1
SHOP_SEARCH_MISS_LOG=1
SHOP_CHAT_ESCALATION=1
SHOP_CART_FOLLOWUP=1
# 1 = trimite follow-up coș abandonat pe WhatsApp (UltraMsg) — necesită ULTRAMSG_* în robot/.env
SHOP_FOLLOWUP_SEND_WHATSAPP=0
# 1 = fallback SMS (WhosMS) când WhatsApp eșuează sau lipsește
SHOP_FOLLOWUP_SEND_SMS=0
# SMS escaladări chat → operator (necesită SHOP_ESCALATION_OPERATOR_PHONE)
SHOP_ESCALATION_SEND_SMS=0
SHOP_ESCALATION_OPERATOR_PHONE=
# WhosMS (același ca ERP Laravel) sau SMS_PROVIDER=msghub
SMS_PROVIDER=whosms
SMS_API_USER=
SMS_API_PASS=
SMS_SENDER_ID=BesoiuAuto
SHOP_CHAT_OLLAMA_AGENTS=1
# Ollama — LLM local unificat (admin, import, scraper, agenți, module viitoare)
# Instalare: ollama pull qwen2.5:7b && ollama pull llava:7b
OLLAMA_ENABLED=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Pe serverul Ollama (shell): export OLLAMA_KV_CACHE_TYPE=q8_0 — economie VRAM context lung
OLLAMA_KV_CACHE_TYPE=q8_0
# Reindex embedding la save produs (1=da). Poate fi lent dacă Ollama e ocupat.
AI_INTEL_AUTO_INDEX=1
# Widget hybrid search în header magazin (1=activ, 0=dezactivat)
AI_INTEL_STOREFRONT_SEARCH=1
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_MODEL_PRODUSE=qwen2.5:7b
OLLAMA_MODEL_CLIENTI=qwen2.5:7b
OLLAMA_MODEL_STATS=qwen2.5:7b
OLLAMA_TIMEOUT_SEC=90
# Normalizare denumiri TecDoc — pas 2 Ollama pe cazuri incerte (Neschimbat / Pattern)
OLLAMA_NAME_NORMALIZE=1
OLLAMA_NAME_NORMALIZE_ON_IMPORT=0
OLLAMA_NAME_NORMALIZE_MIN_CONF=0.65
OLLAMA_QUALITY_MIN_SCORE=45
OLLAMA_BESOIU_MODEL_NAME=besoiu-llama
OLLAMA_USE_BESOIU_MODEL=0
OLLAMA_LOCAL_CYCLE=1
LLM_ROUTER_MODE=ollama_first
IMPORT_OLLAMA_QUALITY_CHECK=1
IMPORT_OLLAMA_QUALITY_ON_SCAN=0
IMPORT_OLLAMA_AUDIT_ON_PUBLISH=1
IMPORT_QUALITY_MIN_SCORE=70
# Date mari import (Poze, Fisierile Matc, Prelucrare) — motorul rulează din app/Import/MatchingPro
BESOIU_IMPORT_DATA_ROOT=C:/laragon/www/besoiupieseimport
# BESOIU_IMPORT_MATCHING_ROOT=C:/laragon/www/besoiupieseauto.ro/app/Import/MatchingPro

# API extern — DOAR task-uri complexe (seo, pricing, sinteză scrape). Obligatoriu pentru Pas 6.
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_PROVIDER=openrouter
EXTERNAL_LLM_MODEL=
# EXTERNAL_LLM_BASE_URL=https://api.x.ai/v1

OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
GROK_MODEL=grok-2-1212

# Surse căutare imagine la import/cron (ordine = prioritate)
# Valori: local_ttc_poze, caietcomenzi, tecdoc_csv, epiesa, emag, tecdoc_api, pieseauto
IMAGE_SEARCH_SOURCES=local_ttc_poze,autopartner_local,caietcomenzi,epiesa,autodoc,tecdoc_api

# Folder sursă imagini TTC (import CLI admin/tools/import_ttc_image_library.php)
# Folder Excel + Poze/{TTC_ART_ID}.jpg — prioritate: env → F:/Poze → G:/Project/.../Poze
TTC_IMAGE_LIBRARY_SOURCE=F:/Poze
# Folder imagini Autopartner (Desktop / FTP: AP_ZDJECIA, AP_MIESIECZNE, CSV)
AUTOPARTNER_IMAGE_DIR=C:/Users/Radu/Desktop/autoparner
# Bază MySQL dedicată (index imagini + lookup). Rebuild: php admin/tools/import_autopartner_image_db.php
AUTOPARTNER_IMAGE_DB=autopartner_images
IMAGINE_PRODUSE_DB=imagine_produse
IMAGINE_POZE_DB=imagine_poze
TTC_POZE_DIR=C:/laragon/www/besoiupieseimport/Poze
TTC_POZE_RENAMED_DIR=C:/laragon/www/besoiupieseimport/Poze_RENUMITE
# La update produs cu audit „replace” — re-caută imagine din surse
IMAGE_AUDIT_AUTO_RETRY=0
# ePiesa la cron import (lent ~90s/produt — necesită SCRAPE_DO_TOKEN)
CRON_CHECK_EPIESA=0
GROQ_KEY=
GEMINI_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
SERPAPI_KEY=
APIFY_TOKEN=

# scrape.do — fallback opțional (SCRAPER_FALLBACK_SCRAPE_DO=1). Scraper admin = stealth-browser-mcp.
SCRAPE_DO_TOKEN=

# Stealth browser local (nodriver) — motor principal pentru TOATE sursele HTML scraper
# Instalare completă (BrowserManager MCP, nu doar nodriver):
#   php admin/tools/setup_stealth_browser.php
# sau: tools/stealth-browser-mcp/venv/Scripts/pip install -r tools/stealth-browser-mcp/requirements.txt
STEALTH_BROWSER_ENABLED=1
# STEALTH_BROWSER_PYTHON=C:/laragon/www/besoiupieseauto.ro/tools/stealth-browser-mcp/venv/Scripts/python.exe
# 1 = headless (implicit, ~500 MB RAM, fără fereastră albă); 0 = Chrome vizibil (doar debug Cloudflare)
STEALTH_BROWSER_HEADLESS=1
# 1 = fallback scrape.do dacă stealth eșuează (implicit 0 — scraper doar stealth-browser-mcp)
SCRAPER_FALLBACK_SCRAPE_DO=0

# RapidAPI: auto-parts-catalog (TecDoc) — necesar pentru imagini când CSV-ul nu are TTC Art ID
# Abonează-te la: https://rapidapi.com/auto-parts-catalog/api/auto-parts-catalog
RAPIDAPI_AUTOPARTS_KEY=
RAPIDAPI_TECDOC_KEY=

# Token pentru agentul local supplier_sync (PC -> upload pe server)
SUPPLIER_SYNC_TOKEN=

# Cron HTTP refresh dashboard snapshot: header X-Dashboard-Cron-Key sau GET ?key= (legacy)
DASHBOARD_CRON_KEY=
AI_AGENT_CRON_KEY=
# 0 = oprește ciclu autonom AI (admin/cron_cli/ai_agent_cycle.php + Task Scheduler)
AI_AGENT_CYCLE_ENABLED=0

# Cron Sync — import automat furnizori (admin/cron)
CRON_IMPORT_MODE=dual
CRON_IMPORT_LIMIT=10
CRON_CATALOG_LIMIT=10
CRON_VITRINA_LIMIT=0
CRON_LIMIT_PER_SUPPLIER=1
CRON_LIGHT_ENRICH=0
CRON_SKIP_TECDOC_CSV=1
CRON_CHECK_EPIESA=0
CRON_AUTO_PUBLISH=0
# Piese catalog (dual) → /admin/importreview cu enrich TecDoc (ca import manual)
CRON_CATALOG_VIA_REVIEW=1
CRON_SCAN_LOCK_MAX_SEC=600
CRON_DASHBOARD_JOBS=installed

# CORS pentru API publice (ex. categorii site). Virgulă = liste; * = doar dev
CORS_ALLOWED_ORIGINS=https://besoiupieseauto.ro,https://www.besoiupieseauto.ro

# Mod „coming soon” — vizitatori fără cheie văd pagina „Site în curând” (Google, direct, etc.)
# Acces magazin: https://besoiupieseauto.ro/?keys=1558 sau ?key=1558 (cookie 90 zile)
# SITE_PREVIEW_LOCK_ALL=1 → blochează și /admin + /robot (login/OAuth admin, webhook/cron/sync rămân deschise)
# SITE_PREVIEW_FORCE=0 → activ și când APP_ENV=development (obligatoriu pe producție dacă APP_ENV nu e production)
SITE_PREVIEW_MODE=0
SITE_PREVIEW_KEY=
SITE_PREVIEW_LOCK_ALL=0
SITE_PREVIEW_FORCE=0
SITE_PREVIEW_COOKIE_DAYS=30

# SEO / indexare Google
# SITE_SEO_NOINDEX=1 → robots.txt Disallow: / (magazin în lucru)
# SITE_PREVIEW_MODE=1 → idem pe domeniu public (fără cheie preview)
SITE_SEO_NOINDEX=0

# PHP CLI: activați ext-zip pentru phpoffice/phpword (composer install)

# MOD TEST doar factura SmartBill + AWB curier (dezactivat implicit)
FULFILLMENT_TEST_MODE=0
FULFILLMENT_SMARTBILL_ENABLED=1
FULFILLMENT_AWB_ENABLED=1
FULFILLMENT_DEFAULT_COURIER=fancourier
FULFILLMENT_TEST_SERIES=TEST
FULFILLMENT_TEST_INVOICE_PREFIX=TEST-INV
FULFILLMENT_TEST_AWB_PREFIX=TEST-AWB

SMARTBILL_API_URL=https://ws.smartbill.ro/SBZ/api
SMARTBILL_API_KEY=
SMARTBILL_USER_EMAIL=
SMARTBILL_COMPANY_VAT=RO31298897
SMARTBILL_SERIES_NAME=BPA_CAI

FANCOURIER_API_URL=https://api.fancourier.ro
FANCOURIER_USERNAME=
FANCOURIER_PASSWORD=
FANCOURIER_CLIENT_ID=
FANCOURIER_SERVICE_STANDARD=Standard
FANCOURIER_SERVICE_COD=Cont Colector
FANCOURIER_COST_CENTER=WEB

SAMEDAY_API_URL=https://api.sameday.ro
SAMEDAY_USERNAME=
SAMEDAY_PASSWORD=
SAMEDAY_PICKUP_POINT_ID=
SAMEDAY_SERVICE_ID=7

# Provisioning FTP/email furnizori — vezi admin/config/hosting_provision.local.php

# Redis — coadă joburi asincrone + tracking AI (coadă ai-events → ai_intel_* MySQL)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TIMEOUT=2.0
REDIS_PREFIX=besoiu:async:
ASYNC_FILE_FALLBACK=1
ASYNC_JOB_TIMEOUT_SEC=60
ASYNC_WORKER_HEARTBEAT_SEC=15
ASYNC_WORKER_IDLE_MS=250
ASYNC_JOB_MAX_ATTEMPTS=3
ASYNC_SSE_MAX_SEC=85
ASYNC_SSE_POLL_MS=1000
ASYNC_SSE_INACTIVITY_SEC=30
ASYNC_IDEMPOTENCY_TTL_SEC=86400
ASYNC_CB_FAILURES=5
ASYNC_CB_COOLDOWN_SEC=60
# Cron: php admin/cron_cli/async_stale_job_sweeper.php (la 60s)
# Workeri: admin/scripts/run_async_workers.bat sau php admin/workers/async_worker.php --queue=products
